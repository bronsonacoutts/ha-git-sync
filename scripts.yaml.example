# scripts.yaml — Git Sync HA Scripts Snippet
#
# Add this to your /config/scripts.yaml (create the file if it doesn't exist).
# Ensure configuration.yaml contains:  script: !include scripts.yaml

maintenance_git_sync_config:
  alias: "[Maintenance] Git Sync Config"
  description: "Reconcile GitHub changes into HA, then publish HA changes through the configured GitHub sync flow"
  sequence:
    - service: shell_command.git_sync
  mode: single

maintenance_git_pull_config:
  alias: "[Maintenance] Git Pull Config"
  description: "Fetch and apply GitHub changes locally without publishing anything back"
  sequence:
    - service: shell_command.git_pull
  mode: single

maintenance_git_push_config:
  alias: "[Maintenance] Git Publish Config"
  description: >-
    Debounced HA-to-GitHub publish: waits for a 3-minute quiet window after the
    last UI-backed config change, then runs the full reconcile flow. mode:
    restart resets the timer on every new trigger so rapid edits are batched.
  sequence:
    - delay: "00:03:00"
    - service: script.maintenance_git_sync_config
  mode: restart

maintenance_git_status:
  alias: "[Maintenance] Git Status"
  description: "Check git status of config directory"
  sequence:
    - service: shell_command.git_status
  mode: single

maintenance_fix_automation_aliases:
  alias: "[Maintenance] Fix Automation Aliases"
  description: "Optional: normalize automation aliases to [Area] Action (Trigger/Context) format"
  sequence:
    - service: shell_command.fix_automation_aliases
  mode: single
